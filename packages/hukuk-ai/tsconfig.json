{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Yalnız testler için: paket yalıtım testi (M0.3) dosya sistemini okur.
    // Çalışma zamanı kodunda node API'si kullanılmaz — aynı test bunu doğrular.
    "types": ["node"]
  },
  "include": ["src"]
}
